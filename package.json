{
  "name": "internship-finder-local",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch backend/server.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build && tsc -p backend/tsconfig.json",
    "start": "node dist/backend/server.js",
    "test": "tsx --test tests/*.test.ts",
    "import": "tsx backend/import-cli.ts",
    "check": "tsc --noEmit",
    "format": "prettier --write backend frontend shared tests docs *.json *.ts *.md"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.6.0",
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "pdf-parse": "^2.4.5",
    "playwright-core": "^1.64.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "saxes": "^6.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.0"
  }
}
